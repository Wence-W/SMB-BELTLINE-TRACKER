{
  // Typechecks the web app, the parity harness, tests and scripts. The Convex
  // backend has its own convex/tsconfig.json. reference/original is only
  // pulled in where the parity oracles import it.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["reference/original/src/*"] }
  },
  "include": [
    "packages",
    "tests",
    "scripts",
    "vitest.config.ts",
    "apps/web/vite.config.ts",
    "apps/web/src/lib/historical.ts", "apps/web/src/lib/billing.ts", "apps/web/src/lib/dates.ts"
  ]
}
