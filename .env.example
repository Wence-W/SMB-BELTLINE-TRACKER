# Frontend (apps/web/.env.local). Only the NEW, owner-owned Convex deployment
# (plan gate G0). Never the old Viktor deployment's URL or keys.
VITE_CONVEX_URL=https://YOUR-NEW-DEPLOYMENT.convex.cloud

# Backend env vars are set in the Convex dashboard (never in git):
#   SITE_URL            the web app's URL (Convex Auth redirects)
#   JWT_PRIVATE_KEY     generated by `npx @convex-dev/auth` setup
#   JWKS                generated by `npx @convex-dev/auth` setup
#   DEPLOYMENT_ENV      "dev" | "staging" | "production"
#   EMAIL_TRANSPORT     "dev-outbox" on dev/staging only; production needs the
#                       BAA-covered provider chosen at G0
