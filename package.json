{
  "name": "smb-beltline-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p convex/tsconfig.json --noEmit",
    "lint": "biome lint . && bun run scripts/check-function-wrappers.ts",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test",
    "fixtures": "bun run packages/parity/generate-fixtures.ts",
    "extract-oracles": "bun run packages/parity/extract-oracles.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.95",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "convex-test": "^0.0.60",
    "fast-check": "^4.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.2.1",
    "vitest": "^4.0.0"
  }
}
